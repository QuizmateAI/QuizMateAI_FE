# QuizMateAI_FE environment template — copy to .env (dev) or .env.production (prod build).
# All values are exposed to the browser bundle; do NOT put secrets here.
#
# At runtime two sources are consulted, in order, by src/lib/runtimeConfig.js:
#   1. window.__APP_CONFIG__ — populated by public/config.js after envsubst at container start
#      (Docker / nginx deploys can re-point the same image at dev/staging/prod by changing the
#      env vars on the container — no rebuild needed).
#   2. import.meta.env.VITE_* — build-time injection. Used by Vite dev server and direct
#      (non-Docker) prod builds.

# =========================================================
# API endpoints
# =========================================================
# Base URL the axios instance points at. Include the /api suffix.
VITE_API_BASE_URL=http://localhost:8080/api
# WebSocket endpoint. If omitted, runtimeConfig derives it from VITE_API_BASE_URL.
VITE_WS_URL=http://localhost:8080/ws-quiz

# =========================================================
# OAuth / Auth
# =========================================================
# Google OAuth 2.0 client id (web). Must match what BE expects in GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# =========================================================
# Branding / Contact
# =========================================================
# Surfaced in landing-page footer + policies "contact us" link. Falls back to
# support@quizmateai.io.vn when unset.
VITE_SUPPORT_EMAIL=support@quizmateai.io.vn
# Canonical site URL for SEO meta tags (RouteMetaManager).
VITE_SITE_URL=https://quizmateai.io.vn

# =========================================================
# Launch / Early Access flags (optional)
# =========================================================
# "true" / "false" — enables the launching-page UI gate.
VITE_LAUNCH_MODE=false
VITE_LAUNCH_BRAND_NAME=QuizMate
VITE_LAUNCH_DATE=2026-04-17T09:00:00+07:00
VITE_LAUNCH_SUPPORT_EMAIL=support@quizmateai.io.vn
VITE_EARLY_ACCESS_URL=

# =========================================================
# Dev-only conveniences
# =========================================================
# Override the Vite dev-server proxy target (defaults to VITE_API_BASE_URL).
# Useful when fronting the BE through an ngrok tunnel for cross-device testing.
# VITE_DEV_PROXY_TARGET=https://your-ngrok-id.ngrok-free.dev
